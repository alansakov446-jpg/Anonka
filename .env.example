# Токен от @BotFather
BOT_TOKEN=

# PostgreSQL DSN для Supabase (опционально). Если не указан или не удаётся
# подключиться — бот автоматически перейдёт на локальный SQLite (bot_data.db).
# Пример: postgres://postgres:PASSWORD@db.SUPABASE_REF.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=

# Количество одновременных проверок (параллелизм)
CONCURRENCY=5

# Пауза (в секундах) между проверками в одном воркере
CHECK_DELAY_SECONDS=0.25

# Опционально: HTTP-прокси
# PROXY_URL=http://user:pass@host:port

# Размеры страниц
PAGE_SIZE_LIVE=6
PAGE_SIZE_HISTORY=10
